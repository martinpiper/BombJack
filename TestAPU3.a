; cd /d C:\Work\BombJack
; ..\c64\acme.exe -v4 --msvc "TestAPU3.a"

; This tests kAPU_Reset_PC with kAPU_SkipIfEQ behaviour with a different data source selected other than the default

!source "stdlib/APU_Macros.a"

!to "TestAPU3.bin" , plain

*=0
	+MAPU
	+MAPU kAPU_Reset_ADDRB1
	+MAPU
	
	+MAPU_LoadDoWait

	+MAPU_LoadEBSFromB1
	+MAPU_LoadEADDRFromB1

	+MAPU kAPU_IDataRegLoad2
	+MAPU kAPU_Incr_ADDRB1

	+MAPU kAPU_ExternalMEWR
	+MAPU kAPU_Incr_ADDRB1 | kAPU_Incr_EADDR
	
	; Test the conditional...
	+MAPU kAPU_IDataSelectReg2
	+MAPU kAPU_Reset_PC | kAPU_SkipIfEQ | kAPU_IDataSelectReg2
	+MAPU kAPU_SkipIfEQ
	
	+MAPU kAPU_ExternalMEWR
	+MAPU kAPU_Incr_ADDRB1 | kAPU_Incr_EADDR

	+MAPU kAPU_Reset_PC
	+MAPU
