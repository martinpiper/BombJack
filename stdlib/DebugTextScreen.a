!zn
DebugTextScreen_VideoInitDisplay
	jsr Bus24Bit_Init
	jsr Video_DisableDisplay
	jsr Video_InitDisplaySpritesScrollsBackground
	lda #kVideo_EnableDisplay_Use_BGColour | kVideo_EnableDisplay_Enable
	jsr Video_EnableDisplay
	jsr Video_SetAddressVideoBackgroundColour
	+MBus24Bit_Send8BitValue 0
	jsr Video_SetAddressVideoOverscanExtentRegisters
	+MBus24Bit_Send8BitValue kBus24Bit_VideoLayer_OverscanExtent_UnsafeWide

	jsr Video_SetAddressPalette
	+MBus24Bit_SendPaletteRGB 16 , 66 , 255
	; Drop shadow
	+MBus24Bit_SendPaletteRGB 0 , 0 , 0
	; Because we are simply combining shifted bitplanes, these two colours are the text colour (text and text|shadow)
	+MBus24Bit_SendPaletteRGB 255 , 255 , 255
	+MBus24Bit_SendPaletteRGB 255 , 255 , 255

	jsr Video_SetAddressVideoPriorityRegister
	+MBus24Bit_VideoLayer_EmitPriority_NearToFar_A kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1

	jsr Video_SetAddressMergeLayer
	+MBus24Bit_Send8BitValue kBus24Bit_MergeLayer_Register_Control_Default
	+MBus24Bit_Send8BitValue 0
	+MBus24Bit_Send8BitValue kBus24Bit_MergeLayer_Register_Control_Visible_1 | kBus24Bit_MergeLayer_Register_Control_ForceOut_1
	+MBus24Bit_Send8BitValue 0

	; Top left of the displayed screen is the start of the chars screen memory
	jsr Video_SetAddressCharScrollRegisters
	+MBus24Bit_SendLE16BitValue -7
	+MBus24Bit_SendLE16BitValue -16
	rts

DebugTextScreen_VideoInitCharset
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenMap_EBBS , kBus24Bit_CharScreenMap
	ldx #0
.cl1
	+MBus24Bit_Send8BitValueFromX
	inx
	bne .cl1

	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenMap_EBBS , kBus24Bit_CharColourMap
	lda #0
	tay
	jsr Bus24Bit_WriteAForY


	; Generate debug text from CHARROM
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_0
	jsr .copyChars
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_1
	jsr .copyChars2
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_2
	ldx #DebugTextScreen_NumCharsetPages
	lda #0
	tay
	jsr Bus24Bit_WriteAForYThenX
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_3
	ldx #DebugTextScreen_NumCharsetPages
	lda #0
	tay
	jsr Bus24Bit_WriteAForYThenX

	+Video_WaitVBlank_EnableNMI

	; Clear "space"
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_0 + (' ' * VIC2CharByteSize)
	jsr .clearChar
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_1 + (' ' * VIC2CharByteSize)
	jsr .clearChar
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_2 + (' ' * VIC2CharByteSize)
	jsr .clearChar
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenPlanes_EBBS , kBus24Bit_CharScreenPlanes_3 + (' ' * VIC2CharByteSize)
	jsr .clearChar

	rts

; Generates the drop shadow from CHARROM
.copyChars
	+MBus24Bit_Send8BitValue 0
	ldy #DebugTextScreen_NumCharsetPages
	+MACROCIAIRQControlDisable_A
	sei

	ldx #0
.cl2
	txa
	and #7
	cmp #7
	bne .doByte
	; Stop bottoms of chars from affect the tops of the next chars
	+MBus24Bit_Send8BitValue 0
	jmp .nextByte
.doByte
	+MByteValueToAddress_A ProcessorPortCharROMBASICKERNAL , ZPProcessorPort
.sma1	lda CHARROM + VIC2MemorySetup_CharsSize,x
	asl
	pha
	+MByteValueToAddress_A ProcessorPortAllRAMWithIO , ZPProcessorPort
	pla
	+MBus24Bit_Send8BitValueFromA
.nextByte
	inx
	bne .cl2
	inc .sma1+2
	dey
	bne .cl2
	rts


; Copies the CHARROM
.copyChars2
	ldy #DebugTextScreen_NumCharsetPages
	+MACROCIAIRQControlDisable_A
	sei

	ldx #0
.cl3
	+MByteValueToAddress_A ProcessorPortCharROMBASICKERNAL , ZPProcessorPort
.sma2	lda CHARROM + VIC2MemorySetup_CharsSize,x
	pha
	+MByteValueToAddress_A ProcessorPortAllRAMWithIO , ZPProcessorPort
	pla
	+MBus24Bit_Send8BitValueFromA
	inx
	bne .cl3
	inc .sma2+2
	dey
	bne .cl3
	rts

.clearChar
	lda #0
	ldy #VIC2CharByteSize
	jmp Bus24Bit_WriteAForY


.pos !word 0
DebugTextScreen_SetPosition_XY
	+MWordValueToAddress_A 0 , .pos

	cpy #0
	beq .ay1
.ay2
	+MAddU8ToAddr16 kBus24Bit_CharScreenWidth , .pos , .pos+1
	dey
	bne .ay2
.ay1
	txa
	+MAddAToAddr16 .pos , .pos+1
	ldx .pos
	lda .pos+1
	adc #>kBus24Bit_CharScreenMap
	tay
	lda #kBus24Bit_CharScreenMap_EBBS
	jmp Bus24Bit_SetAddressBus


DebugTextScreen_Clear_A
	pha
	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenMap_EBBS , kBus24Bit_CharScreenMap
	pla
	ldy #<(kBus24Bit_CharScreenHeight * kBus24Bit_CharScreenWidth)
	ldx #>(kBus24Bit_CharScreenHeight * kBus24Bit_CharScreenWidth)
	jsr Bus24Bit_WriteAForYThenX

	+MBus24Bit_SetAddress_AXY kBus24Bit_CharScreenMap_EBBS , kBus24Bit_CharColourMap
	lda #0
	ldy #<(kBus24Bit_CharScreenHeight * kBus24Bit_CharScreenWidth)
	ldx #>(kBus24Bit_CharScreenHeight * kBus24Bit_CharScreenWidth)
	jmp Bus24Bit_WriteAForYThenX
